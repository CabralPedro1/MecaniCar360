@model MecaniCar360.Models.ViewModels.RegistrarIngresoViewModel
@using MecaniCar360.Models.Enums
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{
    ViewData["Title"] = "Registrar recepcion";
    var turno = Model.Turno!;
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor);
    var retorno = Url.Action("Registrar", new { turnoId = turno.Id });
    var puedeEditarVehiculo = await Permisos.TienePermisoAsync(actor, "VEHICULO_MODIFICAR");
    var abierto = turno.IngresoVehiculo == null && (turno.Estado == EstadoTurno.Pendiente || turno.Estado == EstadoTurno.Confirmado);
}
<h2>Registrar recepcion</h2>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<p>Turno #@turno.Id - @turno.Estado - @turno.Tipo</p>
<p><strong>Cliente:</strong> @turno.Cliente.Nombre @turno.Cliente.Apellido - DNI @turno.Cliente.Dni</p>
<p><strong>Motivo del turno:</strong> @turno.Motivo</p>
@if (await Permisos.TienePermisoAsync(actor, "PERSONA_MODIFICAR")) {
    <a asp-controller="Persona" asp-action="Editar" asp-route-id="@turno.ClienteId" target="_blank" rel="noopener" class="btn btn-outline-secondary">Editar datos del cliente (otra pestana)</a>
}
@if (await Permisos.TienePermisoAsync(actor, "VEHICULO_CREAR")) {
    <a asp-controller="Vehiculo" asp-action="Crear" asp-route-personaId="@turno.ClienteId" asp-route-returnUrl="@retorno" class="btn btn-outline-primary">Registrar vehiculo</a>
}
<p>Realice las correcciones antes de completar la recepcion. Al volver de otra pestana, recargue esta pantalla para revisar los datos actualizados.</p>
@if (!abierto) {
    <p class="alert alert-warning">El turno no permite un nuevo ingreso.</p>
    @if (turno.IngresoVehiculo != null && await Permisos.TienePermisoAsync(actor, "INGRESO_VER")) {
        <a asp-action="Detalle" asp-route-id="@turno.IngresoVehiculo.Id">Ver ingreso existente</a>
    }
} else {
<form asp-action="Registrar" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="TurnoId" type="hidden" />
    <div class="mb-3"><label asp-for="VehiculoId">Vehiculo recibido</label>
        <select asp-for="VehiculoId" class="form-select">
            <option value="">Seleccione vehiculo</option>
            @foreach (var v in Model.Vehiculos) {
                <option value="@v.Id" data-km="@v.Kilometraje">@v.Marca.Nombre @v.Modelo.Nombre - @v.Patente</option>
            }
        </select><span asp-validation-for="VehiculoId" class="text-danger"></span>
        @if (Model.Vehiculos.Count == 0) { <p>No hay vehiculos activos con titularidad vigente. Registre uno para continuar.</p> }
    </div>
    @if (puedeEditarVehiculo) {
        @foreach (var v in Model.Vehiculos) {
            <a asp-controller="Vehiculo" asp-action="Editar" asp-route-id="@v.Id" asp-route-personaId="@turno.ClienteId" asp-route-returnUrl="@retorno" class="btn btn-outline-secondary">Editar @v.Patente</a>
        }
    }
    <div class="mb-3"><label asp-for="Kilometraje">Kilometraje al ingreso</label><input asp-for="Kilometraje" class="form-control" min="0" required /><span asp-validation-for="Kilometraje" class="text-danger"></span><p id="km-conocido" role="status"></p></div>
    <div class="form-check"><input asp-for="ConfirmarKilometrajeMenor" class="form-check-input" /><label asp-for="ConfirmarKilometrajeMenor">Revise y confirmo que el kilometraje ingresado es menor al conocido.</label></div>
    <div class="mb-3"><label asp-for="NivelCombustible">Combustible</label><select asp-for="NivelCombustible" class="form-select" required>
        <option value="">Seleccione nivel</option><option value="0">Reserva</option><option value="1">1/4</option><option value="2">1/2</option><option value="3">3/4</option><option value="4">Lleno</option>
    </select><span asp-validation-for="NivelCombustible" class="text-danger"></span></div>
    <fieldset class="mb-3"><legend>Estado exterior</legend>
        <label><input asp-for="EstadoExterior" type="radio" value="0" required /> Sin danos visibles declarados</label>
        <label><input asp-for="EstadoExterior" type="radio" value="1" required /> Con observaciones</label>
        <span asp-validation-for="EstadoExterior" class="text-danger"></span>
        <label asp-for="DescripcionEstadoExterior">Descripcion (obligatoria si hay observaciones)</label><textarea asp-for="DescripcionEstadoExterior" class="form-control"></textarea><span asp-validation-for="DescripcionEstadoExterior" class="text-danger"></span>
    </fieldset>
    <fieldset class="mb-3"><legend>Objetos y accesorios presentes</legend>
        @foreach (var item in new[] { (AccesoriosRecepcion.RuedaDeAuxilio, "Rueda de auxilio"), (AccesoriosRecepcion.Crique, "Crique"), (AccesoriosRecepcion.LlaveDeRueda, "Llave de rueda"), (AccesoriosRecepcion.Matafuego, "Matafuego"), (AccesoriosRecepcion.Balizas, "Balizas"), (AccesoriosRecepcion.Otros, "Otros") }) {
            <label class="me-3"><input type="checkbox" name="AccesoriosSeleccionados" value="@((int)item.Item1)" checked="@(Model.AccesoriosSeleccionados.Contains(item.Item1))" /> @item.Item2</label>
        }
        <p>Sin selecciones significa que ninguno de los elementos listados permanece en el vehiculo.</p>
        <span asp-validation-for="AccesoriosSeleccionados" class="text-danger"></span>
        <label asp-for="OtrosAccesorios">Descripcion de Otros</label><textarea asp-for="OtrosAccesorios" class="form-control"></textarea><span asp-validation-for="OtrosAccesorios" class="text-danger"></span>
    </fieldset>
    <div class="mb-3"><label asp-for="ObservacionesRecepcion">Observaciones generales de recepcion (opcional)</label><textarea asp-for="ObservacionesRecepcion" class="form-control"></textarea><span asp-validation-for="ObservacionesRecepcion" class="text-danger"></span></div>
    @if (turno.Tipo == TipoTurno.Servicio) {
        <fieldset><legend>Modalidad</legend><label><input asp-for="ClienteEspera" type="radio" value="false" /> Deja el vehiculo</label><label><input asp-for="ClienteEspera" type="radio" value="true" /> Permanece esperando</label></fieldset>
    } else { <p>Diagnostico: el cliente deja el vehiculo.</p> }
    <div class="form-check my-3"><input asp-for="VerificadoConCliente" class="form-check-input" /><label asp-for="VerificadoConCliente">Los datos de recepcion fueron verificados junto con el cliente.</label><span asp-validation-for="VerificadoConCliente" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Confirmar ingreso y crear orden</button>
</form>
}
<a asp-controller="Turno" asp-action="Detalle" asp-route-id="@turno.Id">Volver al turno</a>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const vehiculo = document.getElementById('VehiculoId');
    if (!vehiculo) return;
    const km = document.getElementById('Kilometraje');
    const aviso = document.getElementById('km-conocido');
    function mostrar() {
        const anterior = vehiculo.selectedOptions[0]?.dataset.km;
        aviso.textContent = anterior ? 'Ultimo kilometraje conocido: ' + anterior + (km.value && Number(km.value) < Number(anterior) ? '. Advertencia: confirme expresamente la diferencia.' : '') : 'Sin kilometraje previo registrado.';
    }
    vehiculo.addEventListener('change', mostrar); km.addEventListener('input', mostrar); mostrar();
})();
</script>
}
