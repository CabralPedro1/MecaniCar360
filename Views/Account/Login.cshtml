<h2>Login</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <input name="username" placeholder="Usuario" class="form-control mb-2" />
    <input name="password" type="password" placeholder="Contraseña" class="form-control mb-2" />
    <button class="btn btn-primary">Ingresar</button>
</form>

<p class="text-danger">@ViewBag.Error</p>