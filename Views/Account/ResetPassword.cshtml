@model string

<h2>Restablecer contraseña</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="token" value="@Model" />

    <input type="password" name="password" placeholder="Nueva contraseña" class="form-control mb-2" />
    <input type="password" name="confirmar" placeholder="Confirmar contraseña" class="form-control mb-2" />

    <button class="btn btn-primary">Guardar</button>
</form>

<p class="text-danger">@ViewBag.Error</p>