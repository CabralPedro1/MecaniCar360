@model IEnumerable<MecaniCar360.Models.OrdenTrabajo>
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId);
    var verDetalle = await Permisos.TienePermisoAsync(usuarioId, "ORDEN_VER_DETALLE");
    var asignar = await Permisos.TienePermisoAsync(usuarioId, "ORDEN_ASIGNAR_MECANICO");
}
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (TempData["Ok"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
<nav class="mb-3">
<a asp-action="Index" class="btn btn-secondary">Ordenes</a>
<a asp-action="Pendientes" class="btn btn-outline-primary">Pendientes libres</a>
@if (ViewData["EsMecanicoConsultable"] is true) { <a asp-action="DeMecanico" class="btn btn-outline-primary">Mis ordenes activas</a> }
@if (asignar) { <a asp-action="MecanicosDisponibles" class="btn btn-outline-primary">Mecanicos disponibles</a> }
</nav>


@{
    ViewData["Title"] = "Órdenes de Trabajo";
}

<h2>Órdenes de Trabajo</h2>

<hr />

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model.Any())
{
    <table class="table table-hover table-striped align-middle">

        <thead class="table-dark">

            <tr>

                <th>#</th>

                <th>Cliente</th>

                <th>Vehículo</th>

                <th>Patente</th>

                <th>Mecánico</th>

                <th>Estado</th>

                <th>Urgencia</th>

                <th>Inicio</th>

                <th></th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Id
                    </td>

                    <td>
                        @item.IngresoVehiculo.Turno.Cliente.Nombre
                        @item.IngresoVehiculo.Turno.Cliente.Apellido
                    </td>

                    <td>
                        @item.IngresoVehiculo.Turno.Vehiculo.Marca.Nombre
                        @item.IngresoVehiculo.Turno.Vehiculo.Modelo.Nombre
                    </td>

                    <td>
                        @item.IngresoVehiculo.Turno.Vehiculo.Patente
                    </td>

                    <td>

                        @if (item.Mecanico != null)
                        {
                            @($"{item.Mecanico.Nombre} {item.Mecanico.Apellido}")
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin asignar
                            </span>
                        }

                    </td>

                    <td>

                        @switch (item.EstadoActual)
                        {
                            case MecaniCar360.Models.Enums.EstadoOrden.Pendiente:
                                <span class="badge bg-secondary">@item.EstadoActual</span>
                                break;

                            case MecaniCar360.Models.Enums.EstadoOrden.Diagnostico:
                                <span class="badge bg-info">@item.EstadoActual</span>
                                break;

                            case MecaniCar360.Models.Enums.EstadoOrden.EsperandoAprobacion:
                                <span class="badge bg-warning text-dark">@item.EstadoActual</span>
                                break;

                            case MecaniCar360.Models.Enums.EstadoOrden.Aprobado:
                                <span class="badge bg-primary">@item.EstadoActual</span>
                                break;

                            case MecaniCar360.Models.Enums.EstadoOrden.EnReparacion:
                                <span class="badge bg-primary">@item.EstadoActual</span>
                                break;

                            case MecaniCar360.Models.Enums.EstadoOrden.Finalizado:
                                <span class="badge bg-success">@item.EstadoActual</span>
                                break;

                            case MecaniCar360.Models.Enums.EstadoOrden.Entregado:
                                <span class="badge bg-dark">@item.EstadoActual</span>
                                break;
                        }

                    </td>

                    <td>

                        @switch (item.Urgencia)
                        {
                            case MecaniCar360.Models.Enums.NivelUrgencia.Baja:
                                <span class="badge bg-success">Baja</span>
                                break;

                            case MecaniCar360.Models.Enums.NivelUrgencia.Media:
                                <span class="badge bg-warning text-dark">Media</span>
                                break;

                            case MecaniCar360.Models.Enums.NivelUrgencia.Alta:
                                <span class="badge bg-danger">Alta</span>
                                break;
                        }

                    </td>

                    <td>
                        @item.FechaInicio.ToString("dd/MM/yyyy")
                    </td>

                    <td>

@if (verDetalle) {
                        <a asp-action="Detalle"
                           asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm">

                            Detalle

                        </a>
}
@if (asignar && item.MecanicoId == null && !item.FechaFin.HasValue && item.EstadoActual is not (MecaniCar360.Models.Enums.EstadoOrden.Finalizado or MecaniCar360.Models.Enums.EstadoOrden.Entregado)) {
<a asp-action="MecanicosDisponibles" asp-route-ordenTrabajoId="@item.Id" class="btn btn-sm btn-primary">Asignar mecanico</a>
}


                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <div class="alert alert-info">

        No existen órdenes de trabajo.

    </div>
}