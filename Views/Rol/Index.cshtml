@model IEnumerable<MecaniCar360.Models.Rol>

@{
    ViewData["Title"] = "Roles";
}

<h2>Roles</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="mb-3">

    <a asp-action="Crear"
       class="btn btn-primary">
        Nuevo Rol
    </a>

</div>

@if (Model.Any())
{
    <table class="table table-striped table-hover align-middle">

        <thead class="table-dark">

            <tr>

                <th>Nombre</th>

                <th>Tipo</th>

                <th>Estado</th>

                <th>Fecha creación</th>

                <th style="width:260px"></th>

            </tr>

        </thead>

        <tbody>

            @foreach (var rol in Model)
            {
                <tr>

                    <td>

                        <strong>
                            @rol.Nombre
                        </strong>

                    </td>

                    <td>

                        @if (rol.EsRolCliente)
                        {
                            <span class="badge bg-info">
                                Cliente
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Interno
                            </span>
                        }

                    </td>

                    <td>

                        @if (rol.Activo)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }

                    </td>

                    <td>

                        @rol.FechaCreacion.ToString("dd/MM/yyyy")

                    </td>

                    <td>

                        <a asp-action="Detalle"
                           asp-route-id="@rol.Id"
                           class="btn btn-info btn-sm">
                            Detalle
                        </a>

                        <a asp-action="Editar"
                           asp-route-id="@rol.Id"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <form asp-action="CambiarEstado"
                              asp-route-id="@rol.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button class="btn @(rol.Activo ? "btn-danger" : "btn-success") btn-sm"
                                    onclick="return confirm('¿Desea @(rol.Activo ? "desactivar" : "activar") este rol?')">

                                @(rol.Activo ? "Desactivar" : "Activar")

                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <div class="alert alert-info">

        No existen roles registrados.

    </div>
}