@model Factura
@if (Model.Pagos.Count == 0)
{
    <div class="alert alert-info mc-empty">No hay pagos registrados.</div>
}
else
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">
        <thead class="mc-table-heading"><tr><th scope="col">Fecha</th><th scope="col" class="text-end">Monto</th><th scope="col">Método</th><th scope="col">Estado</th><th scope="col">Registrado por</th></tr></thead>
        <tbody>
        @foreach (var pago in Model.Pagos.OrderByDescending(p => p.FechaPago).ThenByDescending(p => p.Id))
        {
            <tr><td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td><td class="text-end">@pago.Monto.ToString("C2")</td>
                <td>@(pago.MetodoPago switch { MecaniCar360.Models.Enums.MetodoPago.TarjetaCredito => "Tarjeta de crédito", MecaniCar360.Models.Enums.MetodoPago.TarjetaDebito => "Tarjeta de débito", _ => pago.MetodoPago.ToString() })</td>
                <td><span class="mc-state">@pago.Estado</span></td><td>@(pago.RegistradoPorUsuario?.Username ?? "—")</td></tr>
        }
        </tbody>
    </table></div>
}
