@model List<Factura>
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{
    ViewData["Title"] = "Facturas";
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId);
}
<div class="mc-components">
<header class="mc-page-header"><h2>Facturas</h2></header>
<partial name="_Mensajes" />
<div class="mc-actions mb-3">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Volver</a>
    @if (await Permisos.TienePermisoAsync(usuarioId, "ORDEN_VER"))
    {
        <a asp-controller="OrdenTrabajo" asp-action="Index" class="btn btn-outline-primary">Órdenes para facturar</a>
    }
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info mc-empty">No hay facturas emitidas.</div>
}
else
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0">
        <table class="table table-striped align-middle mc-table">
            <thead class="mc-table-heading"><tr><th scope="col">Número</th><th scope="col">Orden</th><th scope="col">Cliente</th><th scope="col">Fecha</th><th scope="col" class="text-end">Total</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
            <tbody>
            @foreach (var factura in Model)
            {
                var cliente = factura.OrdenTrabajo.IngresoVehiculo.Turno.Cliente;
                <tr>
                    <td class="text-break">@factura.NumeroFactura</td><td>@factura.OrdenTrabajoId</td>
                    <td>@cliente.Nombre @cliente.Apellido</td><td>@factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">@factura.Total.ToString("C2")</td><td><span class="mc-state">@factura.Estado</span></td>
                    <td><a asp-action="PorId" asp-route-facturaId="@factura.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

</div>
