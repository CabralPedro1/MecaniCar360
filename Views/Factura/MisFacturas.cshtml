@model List<Factura>
@{
    ViewData["Title"] = "Mis facturas";
}
<div class="mc-components">
<header class="mc-page-header"><h2>Mis facturas</h2></header>
<partial name="_Mensajes" />
<a asp-controller="PortalCliente" asp-action="Index" class="btn btn-secondary mb-3">Volver al portal</a>
@if (Model.Count == 0)
{
    <div class="alert alert-info mc-empty">Todavía no tiene facturas emitidas.</div>
}
else
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0">
        <table class="table table-striped align-middle mc-table">
            <thead class="mc-table-heading"><tr><th scope="col">Número</th><th scope="col">Fecha</th><th scope="col">Vehículo</th><th scope="col" class="text-end">Total</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
            <tbody>
            @foreach (var factura in Model)
            {
                <tr>
                    <td class="text-break">@factura.NumeroFactura</td><td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                    <td>@factura.OrdenTrabajo.IngresoVehiculo.Vehiculo.Patente</td>
                    <td class="text-end">@factura.Total.ToString("C2")</td><td><span class="mc-state">@factura.Estado</span></td>
                    <td><a asp-action="DetallePropio" asp-route-facturaId="@factura.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

</div>
