@model MecaniCar360.Models.ViewModels.NuevoClienteViewModel
@{
    ViewData["Title"] = "Nuevo cliente";
}
<h1>Nuevo cliente</h1>
<form asp-action="NuevoCliente" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre (obligatorio)</label>
        <input asp-for="Nombre" class="form-control" maxlength="100" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Apellido" class="form-label">Apellido (obligatorio)</label>
        <input asp-for="Apellido" class="form-control" maxlength="100" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Dni" class="form-label">DNI (obligatorio)</label>
        <input asp-for="Dni" class="form-control" maxlength="15" />
        <span asp-validation-for="Dni" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefono" class="form-label">Teléfono (opcional)</label>
        <input asp-for="Telefono" class="form-control" maxlength="50" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email (obligatorio)</label>
        <input asp-for="Email" class="form-control" maxlength="100" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Crear cliente</button>
    <a asp-action="Clientes" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
