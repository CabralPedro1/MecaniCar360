@model MecaniCar360.Models.Persona

@{
    ViewData["Title"] = "Detalle de Persona";
}

<h2>Detalle de Persona</h2>
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success" role="status">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId);
}
<div class="mb-3">
    @if (await Permisos.TienePermisoAsync(usuarioId, "VEHICULO_VER"))
    {
        <a asp-controller="Vehiculo" asp-action="Index" asp-route-personaId="@Model.Id" class="btn btn-info">Ver vehículos</a>
    }
    @if (Model.Activo && await Permisos.TienePermisoAsync(usuarioId, "VEHICULO_CREAR"))
    {
        <a asp-controller="Vehiculo" asp-action="Crear" asp-route-personaId="@Model.Id" class="btn btn-primary">Agregar vehículo</a>
    }
</div>

<hr />

<div class="card mb-4">

    <div class="card-header bg-primary text-white">

        Información General

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <dl class="row">

                    <dt class="col-sm-4">
                        Nombre
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Nombre
                    </dd>

                    <dt class="col-sm-4">
                        Apellido
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Apellido
                    </dd>

                    <dt class="col-sm-4">
                        DNI
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Dni
                    </dd>

                </dl>

            </div>

            <div class="col-md-6">

                <dl class="row">

                    <dt class="col-sm-4">
                        Teléfono
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Telefono
                    </dd>

                    <dt class="col-sm-4">
                        Email
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Email
                    </dd>

                    <dt class="col-sm-4">
                        Estado
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }

                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>

<div class="card mb-4">

    <div class="card-header bg-secondary text-white">

        Roles Asignados

    </div>

    <div class="card-body">

        @if (Model.Roles.Any(r => r.FechaBaja == null))
        {
            <div>

                @foreach (var rol in Model.Roles.Where(r => r.FechaBaja == null))
                {
                    <span class="badge bg-primary me-2 mb-2">

                        @rol.Rol.Nombre

                    </span>
                }

            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">

                Esta persona no posee roles asignados.

            </div>
        }

    </div>

</div>

<div>

    <a asp-action="Editar"
       asp-route-id="@Model.Id"
       class="btn btn-warning">

        Editar

    </a>

    <a asp-action="AdministrarRoles"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">

        Administrar Roles

    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        Volver

    </a>

</div>
