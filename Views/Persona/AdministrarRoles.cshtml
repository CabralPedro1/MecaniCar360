@model MecaniCar360.ViewModels.AdministrarRolesViewModel
@{
    ViewData["Title"] = "Administrar roles internos";
}
<div class="mc-components">
<header class="mc-page-header"><h1>Administrar roles internos</h1></header>
<p>@Model.Apellido, @Model.Nombre — DNI: @(Model.Dni ?? "Sin informar")</p>
<p>@(Model.TieneCuenta ? "Con cuenta de acceso" : "Sin cuenta")</p>
@if (TempData["Ok"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<h2>Asignaciones vigentes</h2>
@if (Model.RolesActuales.Count == 0)
{
    <p>No tiene roles internos vigentes.</p>
}
else
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table mc-table">
        <thead class="mc-table-heading"><tr><th scope="col">Rol</th><th scope="col">Estado del rol</th><th scope="col">Operación</th></tr></thead>
        <tbody>
        @foreach (var rol in Model.RolesActuales)
        {
            <tr>
                <td>@rol.Nombre</td><td>@(rol.Activo ? "Activo" : "Inactivo")</td>
                <td>
                    @if (rol.PuedeQuitar)
                    {
                        <form asp-action="QuitarRol" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="personaId" value="@Model.PersonaId" />
                            <input type="hidden" name="rolId" value="@rol.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Quitar rol</button>
                        </form>
                    }
                    else { <span>@rol.Restriccion</span> }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
@if (Model.PuedeAsignar)
{
    <h2>Asignar rol interno</h2>
    <form asp-action="AsignarRol" method="post" class="mc-form-panel mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="personaId" value="@Model.PersonaId" />
        <label for="rolId" class="form-label">Rol</label>
        <select id="rolId" name="rolId" class="form-select mb-2">
            @foreach (var rol in Model.RolesDisponibles)
            {
                <option value="@rol.Id">@rol.Nombre</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Asignar rol</button>
    </form>
}
<a asp-controller="Usuario" asp-action="PersonaCuenta" asp-route-id="@Model.PersonaId" class="btn btn-secondary">Volver a persona y cuenta</a>
</div>
