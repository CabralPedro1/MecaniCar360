@model MecaniCar360.Models.ViewModels.ClientesOperativosViewModel
@{
    ViewData["Title"] = "Clientes";
}
<h1>Clientes</h1>
<form asp-controller="Persona" asp-action="Clientes" method="get" class="mb-3">
    <label for="busqueda" class="form-label">Buscar por nombre, apellido, DNI, email o teléfono</label>
    <div class="input-group">
        <input id="busqueda" name="busqueda" value="@Model.Busqueda" class="form-control" type="search" />
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Clientes" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>
@if (Model.Clientes.Count == 0)
{
    <p>No se encontraron clientes.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Nombre</th><th>Apellido</th><th>DNI</th><th>Teléfono</th><th>Email</th><th>Estado</th><th>Ficha</th></tr></thead>
            <tbody>
            @foreach (var cliente in Model.Clientes)
            {
                <tr>
                    <td>@(cliente.Nombre ?? "Sin informar")</td><td>@(cliente.Apellido ?? "Sin informar")</td>
                    <td>@(cliente.Dni ?? "Sin informar")</td><td>@(cliente.Telefono ?? "Sin informar")</td>
                    <td>@(cliente.Email ?? "Sin informar")</td><td>@(cliente.Activo ? "Activo" : "Inactivo")</td>
                    <td><a asp-action="Cliente" asp-route-id="@cliente.Id">Ver ficha</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
