@model MecaniCar360.Models.Presupuesto
@using MecaniCar360.Models.Enums
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{
    ViewData["Title"] = "Presupuesto";
    string? Entrada(string campo) => ViewData["OperacionRechazada"] as string == "AgregarItem" ? ViewData.ModelState[campo]?.AttemptedValue : null;
    var repuestos = ViewData["Repuestos"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var usuarioId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    var activa = !Model.OrdenTrabajo.FechaFin.HasValue && Model.OrdenTrabajo.Factura == null &&
        Model.OrdenTrabajo.EstadoActual is EstadoOrden.Diagnostico or EstadoOrden.EsperandoAprobacion or
            EstadoOrden.Aprobado or EstadoOrden.EnReparacion or EstadoOrden.Rechazado;
    var editar = activa && await Permisos.TienePermisoAsync(usuarioId, "PRESUPUESTO_MODIFICAR");
    var enviar = activa && Model.Estado == EstadoPresupuesto.Modificado && Model.Items.Any() &&
        await Permisos.TienePermisoAsync(usuarioId, "PRESUPUESTO_ENVIAR");
}
<div class="mc-components">
<header class="mc-page-header"><h2>Presupuesto #@Model.Id</h2></header>
@if (ViewData["ErrorRepuestos"] is string errorRepuestos)
{
    <div class="alert alert-warning" role="alert">@errorRepuestos</div>
}
@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<p>Cliente: @Model.OrdenTrabajo.IngresoVehiculo.Turno.Cliente.Nombre</p>
<p>Vehículo: @Model.OrdenTrabajo.IngresoVehiculo.VehiculoPatenteSnapshot</p>
<p>Estado: @Model.Estado — Total actual: $ @Model.Total.ToString("N2")</p>
@if (editar)
{
    <h4>Agregar ítem</h4>
    <form asp-action="AgregarItem" method="post" class="row g-2 mc-form-panel mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ordenTrabajoId" value="@Model.OrdenTrabajoId" />
        <input type="hidden" name="presupuestoId" value="@Model.Id" />
        <div class="col-md-4"><label class="form-label" for="presupuesto-descripcion">Descripción</label><input name="descripcion" value="@Entrada("descripcion")" id="presupuesto-descripcion" class="form-control" required />@Html.ValidationMessage("descripcion", null, new { @class = "text-danger" })</div>
        <div class="col-md-2"><label class="form-label" for="presupuesto-cantidad">Cantidad</label><input name="cantidad" id="presupuesto-cantidad" type="number" min="1" value="@(Entrada("cantidad") ?? "1")" class="form-control" required />@Html.ValidationMessage("cantidad", null, new { @class = "text-danger" })</div>
        <div class="col-md-2"><label class="form-label" for="presupuesto-precioUnitario">Precio unitario</label><input name="precioUnitario" value="@Entrada("precioUnitario")" id="presupuesto-precioUnitario" type="number" min="0" step="0.01" class="form-control" required />@Html.ValidationMessage("precioUnitario", null, new { @class = "text-danger" })</div>
        <div class="col-md-2"><label class="form-label" for="presupuesto-repuestoId">Repuesto opcional</label><select name="repuestoId" id="presupuesto-repuestoId" class="form-select"><option value="">Sin repuesto</option>
            @foreach (var repuesto in repuestos)
            { <option value="@repuesto.Value" selected="@(Entrada("repuestoId") == repuesto.Value)">@repuesto.Text</option> }
        </select>@Html.ValidationMessage("repuestoId", null, new { @class = "text-danger" })</div>
        <div class="col-md-2"><button class="btn btn-success mt-4">Agregar</button></div>
    </form>
}
<h4 class="mt-4">Ítems actuales</h4>
<div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">
    <thead class="mc-table-heading"><tr><th scope="col">Descripción</th><th scope="col" class="text-end">Cantidad</th><th scope="col" class="text-end">Precio</th><th scope="col" class="text-end">Subtotal</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td>@item.Descripcion</td><td class="text-end">@item.Cantidad</td><td class="text-end">@item.PrecioUnitario.ToString("N2")</td><td class="text-end">@item.Subtotal.ToString("N2")</td>
        <td>@if (editar)
        {
            <form asp-action="EliminarItem" method="post">
                @Html.AntiForgeryToken()
        <input type="hidden" name="ordenTrabajoId" value="@Model.OrdenTrabajoId" />
                <input type="hidden" name="presupuestoId" value="@Model.Id" />
                <input type="hidden" name="itemId" value="@item.Id" />
                <button class="btn btn-danger btn-sm">Eliminar</button>
            </form>
        }</td></tr>
    }
    </tbody>
</table></div>
@if (enviar)
{
    <form asp-action="EnviarAprobacion" method="post" class="mc-form-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ordenTrabajoId" value="@Model.OrdenTrabajoId" />
        <input type="hidden" name="presupuestoId" value="@Model.Id" />
        @foreach (var evidencia in Model.OrdenTrabajo.Evidencias)
        {
            <div class="form-check"><input class="form-check-input" type="checkbox" name="evidenciaIds" value="@evidencia.Id" checked="@((ViewData["EvidenciasSeleccionadas"] as HashSet<int>)?.Contains(evidencia.Id) == true)" id="evidencia-@evidencia.Id" />
            <label class="form-check-label" for="evidencia-@evidencia.Id">@evidencia.Descripcion</label></div>
        }
        @Html.ValidationMessage("evidenciaIds", null, new { @class = "text-danger" })
        <button class="btn btn-primary">Enviar versión al cliente</button>
    </form>
}
<h4 class="mt-4">Versiones enviadas</h4>
@foreach (var version in Model.Versiones.OrderByDescending(v => v.NumeroVersion))
{
    <details class="mb-3">
        <summary>Versión @version.NumeroVersion — @version.Decision — $ @version.Total.ToString("N2") — @version.FechaEnvio</summary>
        <p>@version.MotivoRechazo</p>
        <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table mc-table"><thead class="mc-table-heading"><tr><th scope="col">Descripción</th><th scope="col" class="text-end">Cantidad</th><th scope="col" class="text-end">Precio</th><th scope="col" class="text-end">Subtotal</th></tr></thead>
        <tbody>@foreach (var item in version.Items)
        {
            <tr><td>@item.Descripcion</td><td class="text-end">@item.Cantidad</td><td class="text-end">@item.PrecioUnitario.ToString("N2")</td><td class="text-end">@item.Subtotal.ToString("N2")</td></tr>
        }</tbody></table></div>
        @foreach (var e in version.Evidencias) { <p>Evidencia: @e.EvidenciaTrabajo.Descripcion</p> }
    </details>
}
@if (Model.Versiones.Any() && await Permisos.EsAdministradorAsync(usuarioId))
{
    <a asp-action="Propio" asp-route-ordenTrabajoId="@Model.OrdenTrabajoId" class="btn btn-outline-primary">Consultar envío / intervención administrativa</a>
}
@if (Model.Historial.Any())
{
    <h4 class="mt-4">Historial legado</h4>
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table mc-table"><thead class="mc-table-heading"><tr><th scope="col">Fecha</th><th scope="col" class="text-end">Total anterior</th><th scope="col">Motivo</th></tr></thead><tbody>
    @foreach (var h in Model.Historial.OrderByDescending(h => h.Fecha))
    { <tr><td>@h.Fecha</td><td class="text-end">@h.TotalAnterior.ToString("N2")</td><td>@h.Motivo</td></tr> }
    </tbody></table></div>
}
<a asp-controller="OrdenTrabajo" asp-action="Detalle" asp-route-id="@Model.OrdenTrabajoId" class="btn btn-secondary">Volver a la orden</a>

</div>
