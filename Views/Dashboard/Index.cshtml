@model MecaniCar360.Models.ViewModels.CalendarioViewModel

<h2 class="mb-4">Calendario de Turnos - @Model.Fecha.ToString("dd/MM/yyyy")</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="/Turno/Crear">Nuevo Turno</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th style="width:120px;">Hora</th>
            <th>Turnos</th>
            <th style="width:180px;">Capacidad</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var h in Model.Horarios)
        {
            var porcentaje = (h.Ocupados * 100) / h.CapacidadTotal;

            <tr>
                <!-- HORA -->
                <td>
                    <strong>@h.Hora.ToString("HH:mm")</strong>
                </td>

                <!-- TURNOS -->
                <td>
                    @if (h.Turnos.Any())
                    {
                        foreach (var t in h.Turnos)
                        {
                            <div class="card mb-2">
                                <div class="card-body p-2">

                                    <strong>🚗 @t.Vehiculo.Patente</strong><br />
                                    👤 @t.Cliente.Nombre<br />
                                    ⏰ @t.FechaInicio.ToString("HH:mm")

                                    <div class="mt-2">

                                        @if (t.OrdenTrabajo != null)
                                        {
                                            <!-- YA TIENE ORDEN -->
                                            <a href="/OrdenTrabajo/Detalle/@t.OrdenTrabajo.Id"
                                               class="btn btn-sm btn-dark">
                                                Ver Orden
                                            </a>
                                        }
                                        else
                                        {
                                            <!-- INGRESAR VEHICULO -->
                                            <form method="post" action="/Turno/Ingresar" style="display:inline;">
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button class="btn btn-sm btn-success">
                                                    Ingresar
                                                </button>
                                            </form>
                                        }

                                    </div>

                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Sin turnos</span>
                    }
            </td>

            <!-- CAPACIDAD -->
            <td>
                <div class="progress">
                    <div class="progress-bar
                            @(porcentaje > 80 ? "bg-danger" :
                                                       porcentaje > 50 ? "bg-warning" :
                                                       "bg-success")"
                         style="width:@porcentaje%">

                            @h.Ocupados / @h.CapacidadTotal
                        </div>
                    </div>
                </td>
            </tr>
                }

    </tbody>
</table>