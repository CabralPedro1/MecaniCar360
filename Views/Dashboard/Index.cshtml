@model MecaniCar360.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>
@inject MecaniCar360.Services.PermisoService Permisos
@using System.Security.Claims
@if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId) && await Permisos.TienePermisoAsync(usuarioId, "ORDEN_VER")) {
<a asp-controller="OrdenTrabajo" asp-action="Index" class="btn btn-primary">Consultar ordenes</a>
<a asp-controller="OrdenTrabajo" asp-action="Pendientes" class="btn btn-outline-primary">Ordenes libres</a>
}

@if (ViewData["MostrarResumen"] is true)
{
    <section class="mb-4">
        <h3>Resumen del taller</h3>
        <dl class="row">
            <dt class="col-sm-4">Turnos de hoy</dt>
            <dd class="col-sm-8">@Model.TotalTurnosHoy</dd>
            <dt class="col-sm-4">Órdenes activas</dt>
            <dd class="col-sm-8">@Model.OrdenesActivas</dd>
            <dt class="col-sm-4">Ingresos de hoy</dt>
            <dd class="col-sm-8">@Model.IngresosHoy.ToString("N2")</dd>
        </dl>
    </section>
}

@if (ViewData["MostrarCliente"] is true)
{
    <section class="mb-4">
        <h3>Mi actividad</h3>
        <dl class="row">
            <dt class="col-sm-4">Mis turnos</dt>
            <dd class="col-sm-8">@Model.TurnosCliente.Count</dd>
            <dt class="col-sm-4">Presupuestos pendientes</dt>
            <dd class="col-sm-8">@Model.PresupuestosPendientes.Count</dd>
        </dl>
    </section>
}

@if (ViewData["MostrarMecanico"] is true)
{
    <section class="mb-4">
        <h3>Trabajo asignado</h3>
        <p>Órdenes asignadas: @Model.OrdenesMecanico.Count</p>
    </section>
}

@if (ViewData["MostrarCaja"] is true)
{
    <section class="mb-4">
        <h3>Caja</h3>
        <dl class="row">
            <dt class="col-sm-4">Turnos de hoy</dt>
            <dd class="col-sm-8">@Model.TurnosHoy.Count</dd>
            <dt class="col-sm-4">Facturas pendientes</dt>
            <dd class="col-sm-8">@Model.FacturasPendientes.Count</dd>
        </dl>
    </section>
}

@if (ViewData["MostrarStock"] is true)
{
    <section class="mb-4">
        <h3>Stock</h3>
        <p>Repuestos con stock bajo: @Model.StockBajo.Count</p>
    </section>
}
