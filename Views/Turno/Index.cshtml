@model MecaniCar360.Models.ViewModels.CalendarioViewModel
@{ ViewData["Title"] = "Calendario de turnos"; }

<h2 class="mb-4">
    Calendario de Turnos - @Model.Fecha.ToString("dd/MM/yyyy")
</h2>

<partial name="_Mensajes" />
<form asp-action="Index" method="get" class="mb-3">
    <label for="fecha">Fecha</label>
    <input id="fecha" name="fecha" type="date" value="@Model.Fecha.ToString("yyyy-MM-dd")" required />
    <button class="btn btn-secondary" type="submit">Consultar</button>
    <a asp-action="Agenda" asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Agenda del día</a>
</form>

<div class="mb-3">
    <a class="btn btn-primary" href="/Turno/Crear">
        Nuevo Turno
    </a>
</div>

<div class="table-responsive" role="region" aria-label="Turnos" tabindex="0">
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th style="width:120px;">Hora</th>
            <th scope="col">Turnos</th>
            <th style="width:200px;">Capacidad</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var h in Model.Horarios)
        {
            <tr>
                <!-- HORA -->
                <td>
                    <strong>@h.Hora.ToString("HH:mm")</strong>
                </td>

                <!-- TURNOS -->
                <td>
                    @if (h.Turnos.Any())
                    {
                        foreach (var t in h.Turnos)
                        {
                            <div class="card mb-2">
                                <div class="card-body p-2">

                                    <strong>🚗 @(t.Vehiculo?.Patente ?? "Atención inmediata")</strong><br />
                                    👤 @t.Cliente.Nombre<br />
                                    ⏰ @t.FechaInicio.ToString("HH:mm")

                                    <div>@t.Estado</div>
                                    <div class="mt-2">
                                        <a asp-action="Detalle" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Detalle</a>

                                        @if (t.IngresoVehiculo?.OrdenTrabajo != null)
                                        {
                                            <!-- YA TIENE ORDEN -->
                                            <a href="/OrdenTrabajo/Detalle/@t.IngresoVehiculo.OrdenTrabajo.Id"
                                               class="btn btn-sm btn-dark">
                                                Ver Orden
                                            </a>
                                        }
                                        else
                                        {
                                            <!-- INGRESAR VEHICULO -->
                                            <a asp-controller="IngresoVehiculo"
                                               asp-action="Registrar"
                                               asp-route-turnoId="@t.Id"
                                               class="btn btn-sm btn-success">
                                                Ingresar
                                            </a>
                                        }

                                    </div>

                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Sin turnos</span>
                    }
                </td>

                <!-- CAPACIDAD -->
                <td>
                    @{
                        var porcentaje = h.CapacidadTotal == 0
                        ? 0
                        : (h.Ocupados * 100) / h.CapacidadTotal;

                        var color = porcentaje > 80
                        ? "bg-danger"
                        : porcentaje > 50
                        ? "bg-warning"
                        : "bg-success";
                    }

                    <div class="progress">
                        <div class="progress-bar @color"
                             style="width:@porcentaje%">

                            @h.Ocupados / @h.CapacidadTotal
                        </div>
                    </div>
                </td>
            </tr>
        }

    </tbody>
</table>
</div>
