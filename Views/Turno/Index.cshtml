@model IEnumerable<MecaniCar360.Models.Turno>
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{ ViewData["Title"] = "Turnos"; int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId); }
<h2>Turnos</h2>
<partial name="_Mensajes" />
<a asp-action="Agenda" class="btn btn-secondary">Agenda</a>
@if (await Permisos.TienePermisoAsync(usuarioId, "TURNO_CREAR")) {
<a asp-action="Crear" class="btn btn-primary">Crear turno</a>
}
<partial name="_Lista" model="Model" />
