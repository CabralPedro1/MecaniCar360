@model MecaniCar360.Models.Turno
@using MecaniCar360.Models.Enums
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{
ViewData["Title"] = "Detalle de turno";
int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId);
var modificar = await Permisos.TienePermisoAsync(usuarioId, "TURNO_MODIFICAR");
var seleccion = ViewData.ModelState["nuevaFechaInicio"]?.AttemptedValue;
var fechaElegida = DateTime.TryParse(seleccion, out var fechaIngresada) ? fechaIngresada : Model.FechaInicio;
var abierto = Model.Estado == EstadoTurno.Pendiente || Model.Estado == EstadoTurno.Confirmado;
}
<div class="mc-components">
<header class="mc-page-header"><h2>Turno #@Model.Id</h2></header>
<partial name="_Mensajes" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.IngresoVehiculo != null)
{
    if (await Permisos.TienePermisoAsync(usuarioId, "INGRESO_VER"))
    {
        <a asp-controller="IngresoVehiculo" asp-action="PorTurno" asp-route-turnoId="@Model.Id" class="btn btn-info mb-3">Ver ingreso</a>
    }
}
else if (abierto && await Permisos.TienePermisoAsync(usuarioId, "INGRESO_REGISTRAR"))
{
    <a asp-controller="IngresoVehiculo" asp-action="Registrar" asp-route-turnoId="@Model.Id" class="btn btn-primary mb-3">Registrar ingreso</a>
}
@if (await Permisos.TienePermisoAsync(usuarioId, "INGRESO_VER"))
{
    <a asp-controller="IngresoVehiculo" asp-action="EnTaller" class="btn btn-outline-secondary mb-3">Vehículos en taller</a>
}
<div class="card mb-3"><div class="card-body"><dl class="mc-facts">
<dt>Fecha y hora</dt><dd>@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")</dd>
<dt>Cliente</dt><dd>@Model.Cliente.Apellido, @Model.Cliente.Nombre</dd>
<dt>Vehiculo previsto</dt><dd>@(Model.Vehiculo == null ? "No especificado" : $"{Model.Vehiculo.Patente} - {Model.Vehiculo.Marca.Nombre} {Model.Vehiculo.Modelo.Nombre}")</dd>
<dt>Estado</dt><dd><span class="mc-state">@Model.Estado</span></dd><dt>Tipo</dt><dd>@Model.Tipo</dd>
<dt>Motivo</dt><dd>@Model.Motivo</dd><dt>Observaciones</dt><dd>@(Model.Observaciones ?? "—")</dd>
<dt>Creado</dt><dd>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
</dl></div></div>
@if (Model.Estado == EstadoTurno.Pendiente && await Permisos.TienePermisoAsync(usuarioId, "TURNO_CONFIRMAR")) {
<form asp-action="Confirmar" method="post" class="mb-3 mc-form-panel" onsubmit="return confirm('¿Confirmar turno?');">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
<button type="submit" class="btn btn-success">Confirmar</button></form>
}
@if (abierto && Model.IngresoVehiculo == null && await Permisos.TienePermisoAsync(usuarioId, "TURNO_CANCELAR")) {
<form asp-action="Cancelar" method="post" class="mb-3 mc-form-panel" onsubmit="return confirm('¿Cancelar turno?');">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
<label class="form-label" for="motivo-cancelacion">Motivo de cancelación (opcional)</label><input id="motivo-cancelacion" name="motivo" value="@ViewData.ModelState["motivo"]?.AttemptedValue" class="form-control" />
@Html.ValidationMessage("motivo", null, new { @class = "text-danger" })
<button type="submit" class="btn btn-danger">Cancelar turno</button></form>
}
@if (modificar && Model.Estado == EstadoTurno.Confirmado && Model.FechaInicio <= DateTime.Now) {
<form asp-action="ClienteAusente" method="post" class="mb-3 mc-form-panel" onsubmit="return confirm('¿Marcar cliente ausente?');">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
<button type="submit" class="btn btn-warning">Cliente ausente</button></form>
}
@if (modificar && abierto && Model.IngresoVehiculo == null) {
<h3>Reprogramar</h3>
<form asp-action="Reprogramar" method="post" class="mb-3 mc-form-panel">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
<label class="form-label" for="fecha-turno">Nueva fecha</label><input id="fecha-turno" type="date" value="@fechaElegida.ToString("yyyy-MM-dd")" class="form-control" required />
<label class="form-label" for="horario-turno">Nuevo horario</label><select id="horario-turno" name="nuevaFechaInicio" data-seleccionado="@seleccion" class="form-select" required><option value="">Seleccione horario</option></select>
@Html.ValidationMessage("nuevaFechaInicio", null, new { @class = "text-danger" })
<p id="aviso-horarios" role="status" class="text-danger"></p>
<button type="submit" class="btn btn-primary">Reprogramar</button></form>
}
<div class="mc-actions">
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
<a asp-action="Agenda" asp-route-fecha="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Ver agenda del día</a>
</div>
</div>
@section Scripts {
@if (modificar && abierto && Model.IngresoVehiculo == null) { <partial name="_HorariosScript" /> }
}
