@model MecaniCar360.Models.ViewModels.AgendaViewModel
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{ ViewData["Title"] = "Agenda"; int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId); }
<div class="mc-components">
<header class="mc-page-header"><h2>Agenda del @Model.Fecha.ToString("dd/MM/yyyy")</h2></header>
<partial name="_Mensajes" />
<form asp-action="Agenda" method="get" class="mc-toolbar mb-3">
<label class="form-label" for="fecha">Fecha</label><input id="fecha" name="fecha" class="form-control mc-filter-field" type="date" value="@Model.Fecha.ToString("yyyy-MM-dd")" required />
<button class="btn btn-primary" type="submit">Consultar</button>
</form>
<div class="mc-actions">
@if (Model.Fecha > DateTime.MinValue.Date) {
<a asp-action="Agenda" asp-route-fecha="@Model.Fecha.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Día anterior</a>
}
@if (Model.Fecha < DateTime.MaxValue.Date.AddDays(-1)) {
<a asp-action="Agenda" asp-route-fecha="@Model.Fecha.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Día siguiente</a>
}
<a asp-action="Index" class="btn btn-secondary">Listado</a>
@if (await Permisos.TienePermisoAsync(usuarioId, "TURNO_CREAR")) {
<a asp-action="Crear" class="btn btn-primary">Crear turno</a>
}
</div>
<p class="mt-3">La agenda excluye turnos cancelados y clientes ausentes.</p>
<partial name="_Lista" model="Model.Turnos" />

</div>
