@model IEnumerable<MecaniCar360.Models.Turno>
@if (!Model.Any()) { <p class="mt-3 mc-empty">No hay turnos para mostrar.</p> }
else {
<div class="table-responsive mt-3" role="region" aria-label="Listado de turnos" tabindex="0"><table class="table table-striped mc-table">
<thead class="mc-table-heading"><tr><th scope="col">Fecha</th><th scope="col">Hora</th><th scope="col">Cliente</th><th scope="col">Vehículo</th><th scope="col">Estado</th><th scope="col">Motivo</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
<tbody>
@foreach (var t in Model) {
<tr><td>@t.FechaInicio.ToString("dd/MM/yyyy")</td><td>@t.FechaInicio.ToString("HH:mm")</td>
<td>@t.Cliente.Apellido, @t.Cliente.Nombre</td><td>@(t.Vehiculo?.Patente ?? "No especificado")</td><td><span class="mc-state">@t.Estado</span></td><td>@t.Motivo</td>
<td><a asp-action="Detalle" asp-route-id="@t.Id" class="btn btn-sm btn-info">Detalle</a></td></tr>
}
</tbody></table></div>
}
