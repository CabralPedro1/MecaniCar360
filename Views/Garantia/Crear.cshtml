@model MecaniCar360.Models.ViewModels.CrearGarantiaViewModel
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{ ViewData["Title"] = "Crear garantía"; int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor); }
<div class="mc-components">
<header class="mc-page-header"><h1>Crear garantía — OT #@Model.OrdenTrabajoId</h1></header>
<partial name="_Mensajes" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.Items.Count > 0) {
<p>Inicio de cobertura: @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm") (entrega efectiva).</p>
<p>Seleccione los ítems a cubrir e indique entre 1 y 120 meses para cada uno.</p>
<form asp-action="Crear" method="post" class="mc-form-panel mb-3">
@Html.AntiForgeryToken()
<input type="hidden" name="ordenTrabajoId" value="@Model.OrdenTrabajoId" />
<div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">
<thead class="mc-table-heading"><tr><th scope="col">Incluir</th><th scope="col">Ítem facturado</th><th scope="col">Cantidad</th><th scope="col">Meses</th><th scope="col">Observaciones</th></tr></thead>
<tbody>@foreach (var item in Model.Items) {
    <tr><td><input type="checkbox" name="items.Index" value="@item.Id" checked="@((ViewData["ItemsSeleccionados"] as HashSet<int>)?.Contains(item.Id) == true)" aria-label="Incluir @item.Descripcion" /></td>
    <td>@item.Descripcion<input type="hidden" name="items[@item.Id].FacturaItemId" value="@item.Id" /></td>
    <td>@item.Cantidad</td><td>
        @Html.TextBox($"items[{item.Id}].MesesGarantia", null, new { type = "number", min = "1", max = "120", @class = "form-control", aria_label = $"Meses para {item.Descripcion}" })
        @Html.ValidationMessage($"items[{item.Id}].MesesGarantia", null, new { @class = "text-danger" })
    </td>
    <td>
        @Html.TextBox($"items[{item.Id}].Observaciones", null, new { maxlength = "1000", @class = "form-control", aria_label = $"Observaciones de {item.Descripcion}" })
        @Html.ValidationMessage($"items[{item.Id}].Observaciones", null, new { @class = "text-danger" })
    </td></tr>
}</tbody></table></div>
<button class="btn btn-primary mb-3" type="submit">Crear garantía</button>
</form>
}
@if (await Permisos.TienePermisoAsync(actor, "ORDEN_VER_DETALLE")) {
    <a asp-controller="OrdenTrabajo" asp-action="Detalle" asp-route-id="@Model.OrdenTrabajoId" class="btn btn-secondary">Volver a la orden</a>
}
@if (await Permisos.TienePermisoAsync(actor, "GARANTIA_VER")) {
    <a asp-action="Index" class="btn btn-outline-secondary">Ver garantías</a>
}

</div>
