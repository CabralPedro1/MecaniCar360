@model List<MecaniCar360.Models.ViewModels.GarantiaDetalleViewModel>
@{ var propia = ViewData["Propia"] is true; }
@if (Model.Count == 0) {
    <p class="alert alert-info">No hay garantías para mostrar.</p>
} else {
<div class="table-responsive"><table class="table table-striped">
<thead><tr><th>Garantía / OT</th><th>Vehículo</th>@if (!propia) { <th>Cliente</th> }<th>Inicio</th><th>Fin</th><th>Estado</th><th></th></tr></thead>
<tbody>@foreach (var fila in Model) {
    var g = fila.Garantia; var ingreso = g.OrdenTrabajo.IngresoVehiculo; var v = ingreso.Vehiculo;
    <tr><td>#@g.Id / OT #@g.OrdenTrabajoId</td><td>@v.Patente — @v.Marca.Nombre @v.Modelo.Nombre</td>
    @if (!propia) { <td>@ingreso.Turno.Cliente.Nombre @ingreso.Turno.Cliente.Apellido</td> }
    <td>@g.FechaInicio.ToString("dd/MM/yyyy")</td><td>@g.FechaFin.ToString("dd/MM/yyyy")</td><td>@fila.Estado</td>
    <td><a asp-action="@(propia ? "DetallePropio" : "Detalle")" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a></td></tr>
}</tbody></table></div>
}
