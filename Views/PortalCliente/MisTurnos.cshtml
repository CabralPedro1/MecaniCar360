@model List<Turno>
@using System.Security.Claims
@inject MecaniCar360.Services.PermisoService Permisos
@{ ViewData["Title"] = "Mis turnos"; int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor); }
<h1>Mis turnos</h1>
<partial name="_Mensajes" />
<div class="mb-3"><a asp-action="Index" class="btn btn-secondary">Volver al portal</a>
@if (await Permisos.TienePermisoAsync(actor, "CLIENTE_TURNO_CREAR") && await Permisos.TienePermisoAsync(actor, "CLIENTE_VEHICULO_VER")) {
    <a asp-action="NuevoTurno" class="btn btn-primary">Solicitar turno</a>
}</div>
@if (Model.Count == 0) { <p class="alert alert-info">Todavía no tiene turnos.</p> }
else {
<div class="table-responsive"><table class="table table-striped">
<thead><tr><th>Fecha y hora</th><th>Vehículo previsto</th><th>Motivo</th><th>Estado</th><th></th></tr></thead>
<tbody>@foreach (var t in Model) {
<tr><td>@t.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td><td>@(t.Vehiculo == null ? "Sin especificar" : $"{t.Vehiculo.Patente} — {t.Vehiculo.Marca.Nombre} {t.Vehiculo.Modelo.Nombre}")</td>
<td>@t.Motivo</td><td>@(t.Estado == MecaniCar360.Models.Enums.EstadoTurno.ClienteAusente ? "Cliente ausente" : t.Estado.ToString())</td><td><a asp-action="Turno" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a></td></tr>
}</tbody></table></div>
}
