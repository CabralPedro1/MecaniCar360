@model List<MecaniCar360.Models.ViewModels.PresupuestoPropioResumenViewModel>
@{ ViewData["Title"] = "Mis presupuestos"; }
<div class="mc-components">
<header class="mc-page-header"><h1>Mis presupuestos</h1></header>
<partial name="_Mensajes" />
<p>Última versión enviada de cada presupuesto.</p>
<a asp-action="Index" class="btn btn-secondary mb-3">Volver al portal</a>
@if (Model.Count == 0) { <p class="alert alert-info mc-empty">Todavía no tiene presupuestos enviados.</p> }
else {
<div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">
<thead class="mc-table-heading"><tr><th scope="col">Orden</th><th scope="col">Vehículo</th><th scope="col">Versión</th><th scope="col">Enviado</th><th scope="col">Decisión</th><th scope="col" class="text-end">Total</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
<tbody>@foreach (var p in Model) {
<tr><td>#@p.OrdenTrabajoId</td><td>@p.Patente</td><td>@p.NumeroVersion</td><td>@p.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td><td><span class="mc-state">@p.Decision</span></td><td class="text-end">@p.Total.ToString("C2")</td>
<td><a asp-controller="Presupuesto" asp-action="Propio" asp-route-ordenTrabajoId="@p.OrdenTrabajoId" class="btn btn-outline-primary btn-sm">Ver presupuesto</a></td></tr>
}</tbody></table></div>
}

</div>
