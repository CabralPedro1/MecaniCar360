@model List<MecaniCar360.Models.ViewModels.PresupuestoPropioResumenViewModel>
@{ ViewData["Title"] = "Mis presupuestos"; }
<h1>Mis presupuestos</h1>
<partial name="_Mensajes" />
<p>Última versión enviada de cada presupuesto.</p>
<a asp-action="Index" class="btn btn-secondary mb-3">Volver al portal</a>
@if (Model.Count == 0) { <p class="alert alert-info">Todavía no tiene presupuestos enviados.</p> }
else {
<div class="table-responsive"><table class="table table-striped">
<thead><tr><th>Orden</th><th>Vehículo</th><th>Versión</th><th>Enviado</th><th>Decisión</th><th>Total</th><th></th></tr></thead>
<tbody>@foreach (var p in Model) {
<tr><td>#@p.OrdenTrabajoId</td><td>@p.Patente</td><td>@p.NumeroVersion</td><td>@p.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td><td>@p.Decision</td><td>@p.Total.ToString("C2")</td>
<td><a asp-controller="Presupuesto" asp-action="Propio" asp-route-ordenTrabajoId="@p.OrdenTrabajoId" class="btn btn-outline-primary btn-sm">Ver presupuesto</a></td></tr>
}</tbody></table></div>
}
