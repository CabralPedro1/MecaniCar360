@inject MecaniCar360.Services.PresentacionCuentaService Presentacion
@using System.Security.Claims
@inject MecaniCar360.Services.PermisosVista Permisos
@inject IConfiguration Configuracion
@{
    ViewData["Title"] = "Portal cliente";
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor);
    var cuenta = await Presentacion.ObtenerAsync(actor);
    var accesos = new[] {
        ("CLIENTE_VEHICULO_VER", "PortalCliente", "MisVehiculos", "Mis vehículos"),
        ("CLIENTE_TURNO_VER", "PortalCliente", "MisTurnos", "Mis turnos"),
        ("CLIENTE_ORDEN_VER", "PortalCliente", "MisOrdenes", "Mis órdenes"),
        ("CLIENTE_PRESUPUESTO_VER", "PortalCliente", "MisPresupuestos", "Mis presupuestos"),
        ("CLIENTE_FACTURA_VER", "Factura", "MisFacturas", "Mis facturas"),
        ("GARANTIA_VER_PROPIA", "Garantia", "MisGarantias", "Mis garantías"),
        ("NOTIFICACION_VER", "Notificacion", "Index", "Mis notificaciones") };
}
<h1>Portal cliente</h1>
@if (cuenta.EsClienteHabilitado)
{
<a asp-action="MisDatos" class="btn btn-outline-primary mb-3">Mis datos</a>
@if (ViewBag.DatosPendientes is IReadOnlyList<string> pendientes && pendientes.Count > 0)
{
    <p class="alert alert-info">Para la atención presencial, el taller deberá completar: @string.Join(", ", pendientes). Puede reservar su turno mientras tanto.</p>
}
@if (await Permisos.TienePermisoAsync(actor, "CLIENTE_VEHICULO_CREAR"))
{
    <a asp-action="NuevoVehiculo" class="btn btn-primary mb-3">Registrar mi vehículo</a>
}
@if (MecaniCar360.Helpers.GoogleClienteConfiguracion.Disponible(Configuracion) && cuenta.PuedeVincularGoogle)
{
    <form asp-controller="GoogleCliente" asp-action="Vincular" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <label for="passwordGoogle" class="form-label">Para vincular Google, confirme su contraseña local</label>
        <input id="passwordGoogle" name="password" type="password" autocomplete="current-password" class="form-control mb-2" required />
        <button type="submit" class="btn btn-outline-primary">Vincular Google a mi cuenta</button>
    </form>
}
<p>Consulte sus vehículos, turnos y trabajos del taller.</p>
<partial name="_Mensajes" />
<div class="list-group mb-3">
@foreach (var acceso in accesos)
{
    if (await Permisos.TienePermisoAsync(actor, acceso.Item1))
    {
        <a class="list-group-item list-group-item-action" asp-controller="@acceso.Item2" asp-action="@acceso.Item3">@acceso.Item4</a>
    }
}
</div>
}
else
{
    <p class="alert alert-info">El portal de autogestión requiere una cuenta de cliente habilitada.</p>
}
<a asp-controller="Account" asp-action="Inicio" class="btn btn-secondary">Volver al inicio</a>
