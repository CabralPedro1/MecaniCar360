@model List<Vehiculo>
@{ ViewData["Title"] = "Mis vehículos"; }
<div class="mc-components">
<header class="mc-page-header"><h1>Mis vehículos</h1></header>
<partial name="_Mensajes" />
<a asp-action="Index" class="btn btn-secondary mb-3">Volver al portal</a>
@if (Model.Count == 0) { <p class="alert alert-info">No tiene vehículos disponibles. Consulte al taller para registrar su vehículo.</p> }
else
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">
    <thead class="mc-table-heading"><tr><th scope="col">Patente</th><th scope="col">Marca</th><th scope="col">Modelo</th><th scope="col">Año</th><th scope="col"></th></tr></thead>
    <tbody>@foreach (var v in Model) {
        <tr><td>@v.Patente</td><td>@v.Marca.Nombre</td><td>@v.Modelo.Nombre</td><td>@v.Anio</td>
        <td><a asp-action="Vehiculo" asp-route-id="@v.Id" class="btn btn-outline-primary btn-sm">Ver detalle</a></td></tr>
    }</tbody></table></div>
}
</div>
