@model MecaniCar360.Models.ViewModels.VerificarCorreoClienteViewModel
@{ ViewData["Title"] = "Verificar mi correo"; }
<h1>Verificar mi correo</h1>
@if (ViewBag.Orientacion is string mensaje)
{
    <p class="alert alert-info">@mensaje</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Iniciar sesión</a>
}
else
{
    <p>Si recibió un código, cópielo aquí para consultar las instrucciones de acceso. No cambia su contraseña.</p>
    <form asp-action="Orientacion" method="post">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="text-danger"></div> }
        <label asp-for="Codigo">Código recibido por correo</label>
        <input asp-for="Codigo" autocomplete="off" class="form-control" required />
        <span asp-validation-for="Codigo"></span>
        <button type="submit" class="btn btn-primary">Verificar</button>
    </form>
}
