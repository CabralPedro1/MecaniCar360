@{ ViewData["Title"] = "Inicio"; }
<h1>MecaniCar360</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p>No hay una pantalla de inicio disponible para sus permisos actuales. Consulte al administrador.</p>
}
else
{
