@model IEnumerable<MecaniCar360.Models.Usuario>
@using System.Security.Claims
@inject MecaniCar360.Services.PermisosVista Permisos

@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor);
    var puedeCrear = await Permisos.TienePermisoAsync(actor, "USUARIO_CREAR");
    var puedeEditar = await Permisos.TienePermisoAsync(actor, "USUARIO_MODIFICAR");
    var puedeCambiarEstado = await Permisos.TienePermisoAsync(actor, "USUARIO_DESACTIVAR");
    ViewData["Title"] = "Usuarios";
}

<h2>Usuarios</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    @if (puedeCrear)
    {
        <a asp-action="Crear" class="btn btn-primary">Nueva cuenta</a>
    }
</p>

<div class="table-responsive" role="region" aria-label="Usuarios" tabindex="0">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th scope="col">Usuario</th>
            <th scope="col">Email</th>
            <th scope="col">Persona</th>
            <th scope="col">Estado</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var usuario in Model)
    {
        <tr>
            <td>@usuario.Username</td>
            <td>@usuario.EmailLogin</td>
            <td>@usuario.Persona.Apellido, @usuario.Persona.Nombre</td>
            <td>@(usuario.Activo ? "Activo" : "Inactivo")</td>
            <td>
                <a asp-action="Detalle" asp-route-id="@usuario.Id" class="btn btn-info btn-sm">Detalle</a>
                @if (puedeEditar)
                {
                    <a asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-warning btn-sm">Editar</a>
                }
                @if (puedeCambiarEstado)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@usuario.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary btn-sm">@(usuario.Activo ? "Desactivar" : "Activar")</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
