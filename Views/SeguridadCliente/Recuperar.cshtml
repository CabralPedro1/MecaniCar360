@model MecaniCar360.Models.ViewModels.RecuperarPasswordClienteViewModel
@{ ViewData["Title"] = "Recuperar contraseña de cliente"; }
<div class="mc-components">
<header class="mc-page-header"><h1>Recuperar contraseña de cliente</h1></header>
<form asp-action="Recuperar" method="post" class="mc-form-panel">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="text-danger"></div> }
    <label asp-for="Email" class="form-label">Correo electrónico</label><input asp-for="Email" autocomplete="email" class="form-control" required />
    <span asp-validation-for="Email"></span>
    <button type="submit" class="btn btn-primary">Enviar enlace</button>
</form>
</div>
