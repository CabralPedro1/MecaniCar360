@model MecaniCar360.Models.Proveedor

@{
    ViewData["Title"] = "Detalle proveedor";
}

<div class="mc-components">
<header class="mc-page-header"><h2>Proveedor</h2></header>

<hr />

<div class="card">

    <div class="card-body">

        <h4>
            @Model.Nombre @Model.Apellido
        </h4>

        <p>
            <strong>Teléfono:</strong>
            @Model.Telefono
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

    </div>

</div>

<br />

<h4>Repuestos asociados</h4>

@if (Model.Repuestos.Any())
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">

        <thead class="mc-table-heading">

            <tr>

                <th scope="col">SKU</th>

                <th scope="col">Repuesto</th>

                <th scope="col">Precio Compra</th>

                <th scope="col">Precio Venta</th>

                <th scope="col">Stock</th>

                <th scope="col">Mínimo</th>

                <th scope="col">Principal</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var r in Model.Repuestos)
            {
                <tr>

                    <td>
                        @r.Repuesto.SKU
                    </td>

                    <td>
                        @r.Repuesto.Nombre
                    </td>

                    <td>
                        $ @r.PrecioCompraActual.ToString("N2")
                    </td>

                    <td>
                        $ @r.Repuesto.PrecioVenta.ToString("N2")
                    </td>

                    <td>
                        @r.Repuesto.StockActual
                    </td>

                    <td>
                        @r.Repuesto.StockMinimo
                    </td>

                    <td>

                        @if (r.Principal)
                        {
                            <span class="badge bg-success">
                                Principal
                            </span>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table></div>
}
else
{
    <div class="alert alert-info">

        Este proveedor todavía no posee repuestos asociados.

    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">

    Volver

</a>

</div>
