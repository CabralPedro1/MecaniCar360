@model IEnumerable<MecaniCar360.Models.Repuesto>

@{
    ViewData["Title"] = "Stock";
}

<h2>Stock de Repuestos</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">
        Nuevo Repuesto
    </a>

    <a asp-action="Movimientos" class="btn btn-secondary">
        Historial
    </a>
</p>

<table class="table table-striped table-hover">

    <thead class="table-dark">

        <tr>

            <th>SKU</th>

            <th>Nombre</th>

            <th>Proveedor Principal</th>

            <th>Precio Venta</th>

            <th>Stock</th>

            <th>Mínimo</th>

            <th>Estado</th>

            <th style="width:280px"></th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            var proveedorPrincipal = item.Proveedores
            .FirstOrDefault(p => p.Principal);

            if (proveedorPrincipal == null)
            {
                proveedorPrincipal = item.Proveedores.FirstOrDefault();
            }

            <tr class="@(item.Activo && item.StockActual <= item.StockMinimo ? "table-danger" : "")">

                <td>@item.SKU</td>

                <td>@item.Nombre</td>

                <td>
                    @(proveedorPrincipal?.Proveedor.Nombre ?? "-")
                </td>

                <td>
                    $ @item.PrecioVenta.ToString("N2")
                </td>

                <td>
                    @item.StockActual
                </td>

                <td>
                    @item.StockMinimo
                </td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo
                        </span>
                    }
                </td>

                <td>

                    <a asp-action="Detalle"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Detalle
                    </a>

                    <a asp-action="Editar"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <form asp-action="CambiarEstado"
                          asp-route-id="@item.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn @(item.Activo ? "btn-danger" : "btn-success") btn-sm"
                                onclick="return confirm('¿Desea @(item.Activo ? "desactivar" : "activar") este repuesto?')">

                            @(item.Activo ? "Desactivar" : "Activar")

                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>