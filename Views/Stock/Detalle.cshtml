@model MecaniCar360.Models.Repuesto

@{
    ViewData["Title"] = "Detalle del Repuesto";
    string? Valor(string accion, string campo) => ViewData["MovimientoRechazado"] as string == accion
        ? ViewData.ModelState[campo]?.AttemptedValue : null;
    var ordenes = ViewData["OrdenesSalida"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var lotes = ViewData["LotesRestitucion"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="mc-components">
<header class="mc-page-header"><h2>Detalle del Repuesto</h2></header>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card mb-4">

    <div class="card-header">
        Información del Repuesto
    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-6">

                <p><strong>SKU:</strong> @Model.SKU</p>

                <p><strong>Nombre:</strong> @Model.Nombre</p>

                <p><strong>Marca:</strong> @Model.Marca</p>

                <p><strong>Modelo:</strong> @Model.Modelo</p>

                <p><strong>Compatibilidad:</strong> @Model.Compatibilidad</p>

                <p>
                    <strong>Precio de venta:</strong>
                    $ @Model.PrecioVenta.ToString("N2")
                </p>

            </div>

            <div class="col-md-6">

                <p>
                    <strong>Stock actual:</strong>

                    <span class="badge @(Model.StockActual <= Model.StockMinimo ? "bg-danger" : "bg-success")">
                        @Model.StockActual
                    </span>

                </p>

                <p>
                    <strong>Stock mínimo:</strong>
                    @Model.StockMinimo
                </p>

                <p>
                    <strong>Fecha de alta:</strong>
                    @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")
                </p>

            </div>

        </div>

    </div>

</div>

<div class="card mb-4">

    <div class="card-header">
        Proveedores
    </div>

    <div class="card-body">

        @if (Model.Proveedores.Any())
        {
            <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-bordered mc-table">

                <thead class="mc-table-heading">

                    <tr>

                        <th scope="col">Proveedor</th>

                        <th scope="col">Precio Compra</th>

                        <th scope="col">Código</th>

                        <th scope="col">Principal</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var proveedor in Model.Proveedores)
                    {
                        <tr>

                            <td>@proveedor.Proveedor.Nombre</td>

                            <td>$ @proveedor.PrecioCompraActual.ToString("N2")</td>

                            <td>@proveedor.CodigoProveedor</td>

                            <td>
                                @(proveedor.Principal ? "Sí" : "")
                            </td>

                        </tr>
                    }

                </tbody>

            </table></div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                Este repuesto aún no tiene proveedores asociados.
            </div>
        }

    </div>

</div>

@if (ViewData["PuedeMover"] is true)
{
<div class="row g-3">

    <div class="col-md-4">

        <div class="card">

            <div class="card-header bg-success text-white">
                Registrar ingreso
            </div>

            <div class="card-body">

                <form asp-action="RegistrarIngreso" method="post">
                    <input type="hidden" name="claveOperacion" value="@ViewData["ClaveRegistrarIngreso"]" />

                    @Html.AntiForgeryToken()
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarIngreso")
                    { <div asp-validation-summary="All" class="text-danger" role="alert"></div> }

                    <input type="hidden"
                           name="repuestoId"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="ingreso-proveedorRepuestoId" class="form-label">Proveedor</label>

                        <select id="ingreso-proveedorRepuestoId" name="proveedorRepuestoId" required
                                class="form-select">
                            <option value="">Seleccione un proveedor activo</option>

                            @foreach (var proveedor in Model.Proveedores.Where(p => p.Proveedor.Activo))
                            {
                                <option value="@proveedor.Id" selected="@(Valor("RegistrarIngreso", "proveedorRepuestoId") == proveedor.Id.ToString())">
                                    @proveedor.Proveedor.Nombre -
                                    $ @proveedor.PrecioCompraActual.ToString("N2")
                                    @(proveedor.Principal ? "(Principal)" : "")
                                </option>
                            }

                        </select>
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarIngreso")
                    { @Html.ValidationMessage("proveedorRepuestoId", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">

                        <label for="ingreso-cantidad" class="form-label">Cantidad</label>

                        <input id="ingreso-cantidad" type="number"
                               name="cantidad"
                               min="1" step="1" max="2147483647" required
                               class="form-control" value="@Valor("RegistrarIngreso", "cantidad")" />
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarIngreso")
                    { @Html.ValidationMessage("cantidad", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">

                        <label for="ingreso-observaciones" class="form-label">Observaciones</label>

                        <textarea id="ingreso-observaciones" name="observaciones" maxlength="500"
                                  class="form-control">@Valor("RegistrarIngreso", "observaciones")</textarea>
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarIngreso")
                    { @Html.ValidationMessage("observaciones", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">
                        <label for="precioCompra" class="form-label">Precio unitario real de compra</label>
                        <input id="precioCompra" name="precioCompra" type="number" min="0.01" step="0.01" required class="form-control" value="@Valor("RegistrarIngreso", "precioCompra")" />
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarIngreso")
                    { @Html.ValidationMessage("precioCompra", null, new { @class = "text-danger" }) }
                        <small class="form-text">Confirme el precio de este ingreso. El precio del proveedor se muestra sólo como referencia.</small>
                    </div>

                    <button class="btn btn-success w-100">
                        Registrar ingreso
                    </button>

                </form>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card">

            <div class="card-header bg-warning">
                Registrar salida
            </div>

            <div class="card-body">

                <form asp-action="RegistrarSalida" method="post">
                    <input type="hidden" name="claveOperacion" value="@ViewData["ClaveRegistrarSalida"]" />

                    @Html.AntiForgeryToken()
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarSalida")
                    { <div asp-validation-summary="All" class="text-danger" role="alert"></div> }

                    <input type="hidden"
                           name="repuestoId"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="salida-cantidad" class="form-label">Cantidad</label>

                        <input id="salida-cantidad" type="number"
                               name="cantidad"
                               min="1" step="1" max="2147483647" required
                               class="form-control" value="@Valor("RegistrarSalida", "cantidad")" />
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarSalida")
                    { @Html.ValidationMessage("cantidad", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">

                        <label for="salida-observaciones" class="form-label">Observaciones</label>

                        <textarea id="salida-observaciones" name="observaciones" maxlength="500"
                                  class="form-control">@Valor("RegistrarSalida", "observaciones")</textarea>
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarSalida")
                    { @Html.ValidationMessage("observaciones", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">
                        <label for="ordenTrabajoId" class="form-label">Orden de trabajo</label>
                        <select id="ordenTrabajoId" name="ordenTrabajoId" required class="form-select">
                            <option value="">Seleccione una OT aprobada o en reparación</option>
                            @foreach (var orden in ordenes)
                            { <option value="@orden.Value" selected="@(Valor("RegistrarSalida", "ordenTrabajoId") == orden.Value)">@orden.Text</option> }
                        </select>
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarSalida")
                    { @Html.ValidationMessage("ordenTrabajoId", null, new { @class = "text-danger" }) }
                        @if (!ordenes.Any()) { <p>No hay órdenes habilitadas para salida.</p> }
                    </div>

                    <button class="btn btn-warning w-100">
                        Registrar salida
                    </button>

                </form>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card">

            <div class="card-header bg-primary text-white">
                Ajuste manual
            </div>

            <div class="card-body">

                <form asp-action="RegistrarAjuste" method="post">
                    <input type="hidden" name="claveOperacion" value="@ViewData["ClaveRegistrarAjuste"]" />

                    @Html.AntiForgeryToken()
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarAjuste")
                    { <div asp-validation-summary="All" class="text-danger" role="alert"></div> }

                    <input type="hidden"
                           name="repuestoId"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="diferencia" class="form-label">Diferencia (+/-)</label>

                        <input type="number"
                               id="diferencia" name="diferencia" step="1" min="-2147483647" max="2147483647" required
                               class="form-control" value="@Valor("RegistrarAjuste", "diferencia")" />
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarAjuste")
                    { @Html.ValidationMessage("diferencia", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">

                        <label for="ajuste-observaciones" class="form-label">Motivo</label>

                        <textarea id="ajuste-observaciones" required name="observaciones" maxlength="500"
                                  class="form-control">@Valor("RegistrarAjuste", "observaciones")</textarea>
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarAjuste")
                    { @Html.ValidationMessage("observaciones", null, new { @class = "text-danger" }) }

                    </div>

                    <div class="mb-3">
                        <label for="loteRepuestoId" class="form-label">Lote de origen para restitución</label>
                        <select id="loteRepuestoId" name="loteRepuestoId" class="form-select">
                            <option value="">Seleccione el lote si la diferencia es positiva</option>
                            @foreach (var lote in lotes)
                            { <option value="@lote.Value" selected="@(Valor("RegistrarAjuste", "loteRepuestoId") == lote.Value)">@lote.Text</option> }
                        </select>
                    @if (ViewData["MovimientoRechazado"] as string == "RegistrarAjuste")
                    { @Html.ValidationMessage("loteRepuestoId", null, new { @class = "text-danger" }) }
                        <p>Para restar unidades no elija lote: se consumen primero los ingresos más antiguos (FIFO).</p>
                        <p>Para restituir unidades debe identificar físicamente su lote de origen. Sólo se muestran lotes con capacidad de restitución.</p>
                        @if (!lotes.Any()) { <p>No hay lotes que admitan restitución.</p> }
                    </div>

                    <button class="btn btn-primary w-100">
                        Registrar ajuste
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

}
<hr />

<h3>Últimos movimientos</h3>

@if (Model.Movimientos.Any())
{
    <div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped mc-table">

        <thead class="mc-table-heading">

            <tr>

                <th scope="col">Fecha</th>

                <th scope="col">Tipo</th>

                <th scope="col">Cantidad</th>

                <th scope="col">Observaciones</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var mov in Model.Movimientos
                    .OrderByDescending(x => x.Fecha)
                    .Take(10))
            {
                <tr>

                    <td>@mov.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>

                    <td>@mov.Tipo</td>

                    <td>@mov.Cantidad</td>

                    <td>@mov.Observaciones</td>

                </tr>
            }

        </tbody>

    </table></div>
}
else
{
    <div class="alert alert-info">
        Todavía no existen movimientos para este repuesto.
    </div>
}

<div class="mt-4 mc-actions">

    @if (ViewData["PuedeModificar"] is true)
    {
    <a asp-action="Editar"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="AdministrarProveedores"
       asp-route-id="@Model.Id"
       class="btn btn-primary">

        Administrar proveedores

    </a>
    }
    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</div>
</div>

@section Scripts {
    <script>
        (() => {
            const diferencia = document.getElementById('diferencia');
            const lote = document.getElementById('loteRepuestoId');
            if (!diferencia || !lote) return;
            const actualizar = () => {
                const valor = diferencia.valueAsNumber;
                diferencia.setCustomValidity(valor === 0 ? 'La diferencia no puede ser cero.' : '');
                lote.required = valor > 0;
                lote.disabled = valor < 0;
                if (valor < 0) lote.value = '';
            };
            diferencia.addEventListener('input', actualizar);
            actualizar();
        })();
    </script>
}
