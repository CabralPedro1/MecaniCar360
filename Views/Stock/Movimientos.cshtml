@model IEnumerable<MecaniCar360.Models.MovimientoStock>

@{
    ViewData["Title"] = "Movimientos de Stock";
}

<div class="mc-components">
<header class="mc-page-header"><h2>Historial de Movimientos de Stock</h2></header>

<div class="mb-3">

    <a asp-action="Index"
       class="btn btn-secondary">

        Volver al Stock

    </a>

</div>

<div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table table-striped table-hover mc-table">

    <thead class="mc-table-heading">

        <tr>

            <th scope="col">Fecha</th>

            <th scope="col">Repuesto</th>

            <th scope="col">Proveedor</th>

            <th scope="col">Tipo</th>

            <th scope="col">Cantidad</th>

            <th scope="col">Usuario</th>

            <th scope="col">Orden</th>

            <th scope="col">Observaciones</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var movimiento in Model)
        {
            <tr>

                <td>
                    @movimiento.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @movimiento.Repuesto.Nombre
                </td>

                <td>

                    @(movimiento.ProveedorRepuesto != null
                                    ? movimiento.ProveedorRepuesto.Proveedor.Nombre
                                    : "-")

            </td>

                <td>

                @switch (movimiento.Tipo)
                    {
                        case MecaniCar360.Models.Enums.TipoMovimientoStock.IngresoCompra:
                            <span class="badge bg-success">
                                Ingreso
                            </span>
                            break;

                        case MecaniCar360.Models.Enums.TipoMovimientoStock.EgresoOrdenTrabajo:
                            <span class="badge bg-danger">
                                Salida
                            </span>
                            break;

                        case MecaniCar360.Models.Enums.TipoMovimientoStock.Ajuste:
                            <span class="badge bg-primary">
                                Ajuste
                            </span>
                            break;
                    }

                </td>

                <td>

                    @if (movimiento.Cantidad > 0)
                    {
                        <span class="text-success">
                            +@movimiento.Cantidad
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            @movimiento.Cantidad
                        </span>
                    }

            </td>

            <td>

                @(movimiento.RealizadoPorUsuario != null
                                ? $"{movimiento.RealizadoPorUsuario.Persona.Nombre} {movimiento.RealizadoPorUsuario.Persona.Apellido}"
                                : "-")

            </td>

                <td>

                    @(movimiento.OrdenTrabajoId?.ToString() ?? "-")

                </td>

                <td>

                    @movimiento.Observaciones

                </td>

            </tr>
                }

    </tbody>

</table></div>

</div>
