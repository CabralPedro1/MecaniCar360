@inject MecaniCar360.Services.PermisoService Permisos
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MecaniCar360</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MecaniCar360.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        @using System.Security.Claims

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">🚗 MEC360</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <ul class="navbar-nav me-auto">

                        <!-- DASHBOARD -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Inicio</a>
                        </li>

                        <!-- TURNOS -->
                        @if (!User.IsInRole("CLIENTE"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Turno" asp-action="Index">Turnos</a>
                            </li>
                        }

                        <!-- CLIENTE -->
                        @if (User.IsInRole("CLIENTE"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Turno/MisTurnos">Mis Turnos</a>
                            </li>
                        }

                        <!-- MECANICO -->
                        @if (User.IsInRole("MECANICO"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="OrdenTrabajo" asp-action="Index">Ordenes</a>
                            </li>
                        }

                        <!-- STOCK -->
                        @if (User.IsInRole("STOCK"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Stock" asp-action="Index">Repuestos</a>
                            </li>
                        }

                        <!-- FACTURACIÓN: permisos efectivos, identidad del usuario -->
                        @{
                            int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioFacturacionId);
                        }
                        @if (usuarioFacturacionId > 0 && await Permisos.TienePermisoAsync(usuarioFacturacionId, "FACTURA_VER"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Factura" asp-action="Index">Facturas</a>
                            </li>
                        }
                        else if (usuarioFacturacionId > 0 && await Permisos.TienePermisoAsync(usuarioFacturacionId, "CLIENTE_FACTURA_VER"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Factura" asp-action="MisFacturas">Mis facturas</a>
                            </li>
                        }
                        <!-- ADMIN -->
                        @if (User.IsInRole("ADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                            </li>

                        }

                    </ul>

                    <!-- USER -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="navbar-text text-white me-3">
                                👤 @User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light me-2" href="/Account/CambiarContraseña">Cambiar contraseña</a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light" type="submit">Salir</button>
                            </form>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MecaniCar360
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
