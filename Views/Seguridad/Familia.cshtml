@model MecaniCar360.Models.ViewModels.SeguridadViewModel
@{ ViewData["Title"] = "Seguridad"; }
<partial name="_Mensajes" />
@{ var f = Model.Familias.Single(x => x.Id == (int)ViewBag.FamiliaId); }
<div class="mc-components">
<header class="mc-page-header"><h1>@f.Nombre</h1></header><p>@f.Descripcion</p><p>Estado: @(f.Activo ? "Activa" : "Inactiva")</p>
@if (MecaniCar360.Services.PoliticaSeguridadEstructural.PermiteModificar)
{
<a asp-action="Editar" asp-route-id="@f.Id" class="btn btn-primary">Editar datos</a>
} <a asp-action="Index" class="btn btn-secondary">Volver</a>
<h2 class="mt-3">Patentes directas</h2>
<ul>@foreach (var p in Model.Patentes.Where(p => f.Patentes.Any(fp => fp.PatenteId == p.Id))) {
<li>@p.Nombre — @p.Descripcion
@if (MecaniCar360.Services.PoliticaSeguridadEstructural.PermiteModificar)
{
<form asp-action="Patente" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="familiaId" value="@f.Id" /><input type="hidden" name="patenteId" value="@p.Id" /><input type="hidden" name="agregar" value="false" /><button class="btn btn-sm btn-outline-danger">Quitar</button></form>
}</li>
}</ul>
@if (MecaniCar360.Services.PoliticaSeguridadEstructural.PermiteModificar)
{
<form asp-action="Patente" method="post" class="mc-form-panel d-flex flex-column flex-sm-row flex-wrap gap-2 mb-3">@Html.AntiForgeryToken()<input type="hidden" name="familiaId" value="@f.Id" /><input type="hidden" name="agregar" value="true" /><label for="patenteId" class="form-label">Patente</label><select id="patenteId" name="patenteId" class="form-select" required><option value="">Seleccione</option>@foreach (var p in Model.Patentes.Where(p => p.Activo && !f.Patentes.Any(fp => fp.PatenteId == p.Id))) { <option value="@p.Id">@p.Nombre</option> }</select><button class="btn btn-primary">Agregar</button></form>
}
<h2>Familias hijas</h2><p>Cada familia puede tener un único padre. La composición se consulta en modo de solo lectura.</p>
<ul>@foreach (var h in Model.Familias.Where(h => h.FamiliaPadreId == f.Id)) {
<li><a asp-action="Familia" asp-route-id="@h.Id">@h.Nombre</a>
@if (MecaniCar360.Services.PoliticaSeguridadEstructural.PermiteModificar)
{
<form asp-action="Hija" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="familiaId" value="@f.Id" /><input type="hidden" name="hijaId" value="@h.Id" /><input type="hidden" name="agregar" value="false" /><button class="btn btn-sm btn-outline-danger">Quitar</button></form>
}</li>
}</ul>
@if (MecaniCar360.Services.PoliticaSeguridadEstructural.PermiteModificar)
{
<form asp-action="Hija" method="post" class="mc-form-panel d-flex flex-column flex-sm-row flex-wrap gap-2 mb-3">@Html.AntiForgeryToken()<input type="hidden" name="familiaId" value="@f.Id" /><input type="hidden" name="agregar" value="true" /><label for="hijaId" class="form-label">Familia hija</label><select id="hijaId" name="hijaId" class="form-select" required><option value="">Seleccione</option>@foreach (var h in Model.Familias.Where(h => h.Id != f.Id && h.FamiliaPadreId == null)) { <option value="@h.Id">@h.Nombre</option> }</select><button class="btn btn-primary">Agregar</button></form>
}
<h2>Roles con asignación directa</h2><ul>@foreach (var r in Model.Roles.Where(r => r.Familias.Any(rf => rf.FamiliaId == f.Id))) { <li><a asp-action="Rol" asp-route-id="@r.Id">@r.Nombre</a></li> }</ul>
</div>
