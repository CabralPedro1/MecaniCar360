@model MecaniCar360.Models.ViewModels.SeguridadViewModel
@{ ViewData["Title"] = "Seguridad"; }
<partial name="_Mensajes" />
<div class="mc-components">
<header class="mc-page-header"><h1>Catálogo técnico de patentes</h1></header><p>Los códigos son definidos por el sistema. Aquí puede consultar su composición, no crear capacidades arbitrarias.</p><a asp-action="Index" class="btn btn-secondary">Volver</a>
<div class="table-responsive" role="region" aria-label="Tabla desplazable" tabindex="0"><table class="table mc-table"><thead class="mc-table-heading"><tr><th scope="col">Código</th><th scope="col">Descripción</th><th scope="col">Estado</th><th scope="col">Familias directas</th></tr></thead><tbody>
@foreach (var p in Model.Patentes) { <tr><td>@p.Nombre</td><td>@p.Descripcion</td><td>@(p.Activo ? "Activa" : "Inactiva")</td><td>@foreach (var f in Model.Familias.Where(f => f.Patentes.Any(fp => fp.PatenteId == p.Id))) { <a class="me-2" asp-action="Familia" asp-route-id="@f.Id">@f.Nombre</a> }</td></tr> }
</tbody></table></div>
</div>
