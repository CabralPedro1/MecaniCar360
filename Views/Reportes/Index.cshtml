@model MecaniCar360.Models.ViewModels.ReporteFiltro
@{ ViewData["Title"] = "Reportes"; }
<div class="mc-components">
<header class="mc-page-header"><h1>Reportes</h1></header>
<p>Rendimiento del taller, facturación/cobranzas y conceptos de trabajos finalizados.</p>
<form asp-action="Resultado" method="get" class="mc-toolbar">
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="text-danger"></div> }
<div class="row g-3 w-100">
<div class="col-sm-4"><label asp-for="Desde" class="form-label"></label><input asp-for="Desde" type="date" required class="form-control" /><span asp-validation-for="Desde"></span></div>
<div class="col-sm-4"><label asp-for="Hasta" class="form-label"></label><input asp-for="Hasta" type="date" required class="form-control" /><span asp-validation-for="Hasta"></span></div>
</div>
<p class="text-muted">Hasta 367 días inclusive. Ambas fechas se incluyen.</p>
<button class="btn btn-primary" type="submit">Generar reportes</button>
</form>
</div>
